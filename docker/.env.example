# SkyBook AI lab environment (NOT for production)
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=skybook
DB_USER=skybook
DB_PASSWORD=skybook

JWT_SECRET=SkyBookLabOnlySecretKeyChangeMe_MustBeAtLeast256BitsLong!!
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
AI_HOST_PORT=8000
MYSQL_HOST_PORT=3306

# Intentionally vulnerable endpoints are ENABLED by default for this training lab.
# Set TRAINING_MODE=false / SPRING_PROFILES_ACTIVE=default to hide them.
TRAINING_MODE=true
SPRING_PROFILES_ACTIVE=training

# Optional LLM for AI service
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
